# Authentix Frontend Environment Configuration
# Copy this file to .env in the same folder and update values

# API base URL for communication with the FastAPI backend
# Leave empty or set to '/api' to use Vite local proxy.
# Set to 'http://localhost:8000/api' for direct local connection.
# Set to 'https://authentix-backend.onrender.com/api' for production deployment.
VITE_API_BASE_URL=http://localhost:8000/api
